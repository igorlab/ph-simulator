		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "52675bcc-4ccd-51f4-8c28-e81a621c5e71")
	)
	(text "R5 = Rsh, shunt in the board ground:\nboard current = V(A3) / R5"
		(exclude_from_sim no)
		(at 187.96 149.86 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "63b2302a-23d9-5687-b549-f31018379ec1")
	)
	(text "SW1 is cross-wired: the two\nON positions give +E and -E,\nthe middle one switches it off."
		(exclude_from_sim no)
		(at 25.4 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "6df0c88f-1122-589c-941e-b43b83439009")
	)
	(text "SW2 pressed: R2 shorted, the board input is E (calibration).\nSW2 released: the signal goes through R2 (leakage measurement)."
		(exclude_from_sim no)
		(at 88.9 110.49 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "a8227365-e8ff-55ba-b0cd-0842f7d610b4")
	)
	(text "ADDR to GND: address 0x48\nA0 - A1: simulator voltage E\nA2: S / 2\nA3: voltage on the shunt R5"
		(exclude_from_sim no)
		(at 121.92 86.36 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "b6bed4bd-702b-581e-abfb-4aad95de2e77")
	)
	(text "pH electrode simulator and leakage tester"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2.54 2.54)
				(bold yes)
			)
			(justify left top)
		)
		(uuid "ed6eb289-4412-5da8-86a2-7f6bc567fe74")
	)
	(text "Address 0x3C. Wire by the printed pin names."
		(exclude_from_sim no)
		(at 198.12 83.82 0)
		(effects
			(font
				(size 1.27 1.27)
				(italic yes)
			)
			(justify left top)
		)
		(uuid "f4534a2f-337c-5f0e-a932-e2ad61d957dc")
	)
	(text "1. Power the ADS1115 and the OLED from 3.3 V, never from 5 V.\n2. The simulator voltage E is measured BEFORE R2; the board input VIN is worked out from S.\n3. Leakage: I = (VIN - E) / R2 after a two-point calibration with SW2 pressed.\n4. The simulator floats and REF has no divider of its own: channel A is valid only with a pH board connected.\n5. Optional, not fitted: 10k from 3.3 V and 10k to GND with 100 nF, midpoint on REF, make A valid on its own."
		(exclude_from_sim no)
		(at 25.4 28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "faab4776-9480-5829-b3c4-0d553fc9330d")
	)
